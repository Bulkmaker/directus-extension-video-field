{
  "name": "directus-extension-video-field",
  "version": "1.0.1",
  "description": "Video field with metadata parsing for YouTube, Vimeo, Rutube, and VKVideo.",
  "icon": "video_library",
  "keywords": [
    "directus",
    "directus-extension",
    "video",
    "youtube",
    "vimeo",
    "rutube",
    "vk-video",
    "oembed",
    "metadata"
  ],
  "author": "Miša <ibull37@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bulkmaker/directus-extension-video-field"
  },
  "homepage": "https://github.com/bulkmaker/directus-extension-video-field#readme",
  "bugs": {
    "url": "https://github.com/bulkmaker/directus-extension-video-field/issues"
  },
  "type": "module",
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "interface",
        "name": "video-field",
        "source": "src/interface/index.ts"
      },
      {
        "type": "display",
        "name": "video-display",
        "source": "src/display/index.ts"
      },
      {
        "type": "endpoint",
        "name": "video-parser",
        "source": "src/api/index.ts"
      }
    ],
    "host": "^10.0.0 || ^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "prepare": "directus-extension build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "multer": "^2.0.2",
    "@directus/extensions-sdk": "^12.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.4.0"
  }
}
